<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SpanishReader.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SpanishReader.Core.Models"
    xmlns:local="using:SpanishReader.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Themes/ReaderTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{ThemeResource ReaderCanvasBrush}" SizeChanged="OnPageSizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="LibraryShell.Margin" Value="16,8,16,16" />
                        <Setter Target="LibraryPaper.Padding" Value="16,16,16,12" />
                        <Setter Target="LibraryHeading.FontSize" Value="26" />
                        <Setter Target="LibrarySearch.Width" Value="160" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid x:Name="LibraryShell" Margin="24,12,24,20" MaxWidth="1220">
            <Border x:Name="LibraryPaper" Background="{ThemeResource ReaderPaperBrush}"
                    BorderBrush="{ThemeResource ReaderRuleBrush}" BorderThickness="1" CornerRadius="4" Padding="24,20,24,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="10" Margin="0,0,0,12">
                        <TextBlock x:Name="LibraryHeading" Text="Library" Style="{StaticResource ReaderPageHeadingStyle}" FontSize="28"
                                   AutomationProperties.AutomationId="LibraryHeading" />
                        <Border Height="1" Width="48" Background="{ThemeResource ReaderAccentBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <CommandBar Grid.Row="1" Background="Transparent" Foreground="{ThemeResource ReaderInkBrush}"
                                IsEnabled="{x:Bind ViewModel.CanUseLibrary, Mode=OneWay}"
                                DefaultLabelPosition="Right" VerticalContentAlignment="Center" IsDynamicOverflowEnabled="True">
                        <CommandBar.Content>
                            <AutoSuggestBox
                                x:Name="LibrarySearch" Width="280"
                                Margin="0,0,12,0"
                                PlaceholderText="Search library"
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchText, Mode=OneWay}" TextChanged="OnSearchTextChanged"
                                Background="{ThemeResource ReaderNotesBrush}" Foreground="{ThemeResource ReaderInkBrush}"
                                BorderBrush="{ThemeResource ReaderRuleBrush}"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="LibrarySearch"
                                AutomationProperties.Name="Search library" />
                        </CommandBar.Content>

                        <AppBarButton Icon="Add" Label="Import" AutomationProperties.AutomationId="OpenImport" AutomationProperties.Name="Import to library" Command="{x:Bind ViewModel.ImportStoryCommand}" />

                        <AppBarButton Icon="Sort" Label="Sort by" AutomationProperties.AutomationId="LibrarySort" AutomationProperties.Name="Sort library">
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <RadioMenuFlyoutItem Text="Date added — newest first" GroupName="LibrarySort" Tag="NewestFirst"
                                        Click="OnSortClicked" IsChecked="{x:Bind local:MainPage.IsSortSelected(ViewModel.SelectedSortOrder, 'NewestFirst'), Mode=OneWay}"
                                        AutomationProperties.AutomationId="SortNewestFirst" />
                                    <RadioMenuFlyoutItem Text="Date added — oldest first" GroupName="LibrarySort" Tag="OldestFirst"
                                        Click="OnSortClicked" IsChecked="{x:Bind local:MainPage.IsSortSelected(ViewModel.SelectedSortOrder, 'OldestFirst'), Mode=OneWay}"
                                        AutomationProperties.AutomationId="SortOldestFirst" />
                                    <RadioMenuFlyoutItem Text="CEFR level — A1 to C2" GroupName="LibrarySort" Tag="CefrAscending"
                                        Click="OnSortClicked" IsChecked="{x:Bind local:MainPage.IsSortSelected(ViewModel.SelectedSortOrder, 'CefrAscending'), Mode=OneWay}"
                                        AutomationProperties.AutomationId="SortCefrAscending" />
                                    <RadioMenuFlyoutItem Text="CEFR level — C2 to A1" GroupName="LibrarySort" Tag="CefrDescending"
                                        Click="OnSortClicked" IsChecked="{x:Bind local:MainPage.IsSortSelected(ViewModel.SelectedSortOrder, 'CefrDescending'), Mode=OneWay}"
                                        AutomationProperties.AutomationId="SortCefrDescending" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>

                        <AppBarButton Icon="Filter" Label="CEFR level" AutomationProperties.AutomationId="LibraryLevel" AutomationProperties.Name="Filter library by CEFR level">
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <RadioMenuFlyoutItem Text="All levels" GroupName="LibraryLevel" Tag="All"
                                        Click="OnLevelClicked" IsChecked="{x:Bind local:MainPage.IsLevelSelected(ViewModel.SelectedLevel, 'All'), Mode=OneWay}"
                                        AutomationProperties.AutomationId="FilterAll" />
                                    <RadioMenuFlyoutItem Text="A1" GroupName="LibraryLevel" Tag="A1"
                                        Click="OnLevelClicked" IsChecked="{x:Bind local:MainPage.IsLevelSelected(ViewModel.SelectedLevel, 'A1'), Mode=OneWay}"
                                        AutomationProperties.AutomationId="FilterA1" />
                                    <RadioMenuFlyoutItem Text="A2" GroupName="LibraryLevel" Tag="A2"
                                        Click="OnLevelClicked" IsChecked="{x:Bind local:MainPage.IsLevelSelected(ViewModel.SelectedLevel, 'A2'), Mode=OneWay}"
                                        AutomationProperties.AutomationId="FilterA2" />
                                    <RadioMenuFlyoutItem Text="B1" GroupName="LibraryLevel" Tag="B1"
                                        Click="OnLevelClicked" IsChecked="{x:Bind local:MainPage.IsLevelSelected(ViewModel.SelectedLevel, 'B1'), Mode=OneWay}"
                                        AutomationProperties.AutomationId="FilterB1" />
                                    <RadioMenuFlyoutItem Text="B2" GroupName="LibraryLevel" Tag="B2"
                                        Click="OnLevelClicked" IsChecked="{x:Bind local:MainPage.IsLevelSelected(ViewModel.SelectedLevel, 'B2'), Mode=OneWay}"
                                        AutomationProperties.AutomationId="FilterB2" />
                                    <RadioMenuFlyoutItem Text="C1" GroupName="LibraryLevel" Tag="C1"
                                        Click="OnLevelClicked" IsChecked="{x:Bind local:MainPage.IsLevelSelected(ViewModel.SelectedLevel, 'C1'), Mode=OneWay}"
                                        AutomationProperties.AutomationId="FilterC1" />
                                    <RadioMenuFlyoutItem Text="C2" GroupName="LibraryLevel" Tag="C2"
                                        Click="OnLevelClicked" IsChecked="{x:Bind local:MainPage.IsLevelSelected(ViewModel.SelectedLevel, 'C2'), Mode=OneWay}"
                                        AutomationProperties.AutomationId="FilterC2" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                    </CommandBar>

                    <!-- Closed InfoBars still occupy a StackPanel slot. Avoid
                         spacing between slots so a quiet library has no empty status band. -->
                    <StackPanel Grid.Row="2">
                        <InfoBar Severity="Error" IsClosable="True"
                                 IsOpen="{x:Bind local:UiHelpers.HasText(ViewModel.ActionErrorMessage), Mode=OneWay}"
                                 Message="{x:Bind ViewModel.ActionErrorMessage, Mode=OneWay}"
                                 AutomationProperties.AutomationId="LibraryActionError" />
                        <ProgressBar IsIndeterminate="True" Foreground="{ThemeResource ReaderAccentBrush}"
                                     AutomationProperties.Name="Deleting story"
                                     Visibility="{x:Bind local:UiHelpers.When(ViewModel.IsDeleting), Mode=OneWay}" />
                        <InfoBar Severity="Success" IsClosable="True"
                                 IsOpen="{x:Bind local:UiHelpers.HasText(ViewModel.SuccessMessage), Mode=OneWay}"
                                 Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                                 AutomationProperties.AutomationId="ImportSuccess" />
                        <InfoBar Severity="Warning" IsClosable="True"
                                 IsOpen="{x:Bind local:UiHelpers.HasText(ViewModel.ImportWarningMessage), Mode=OneWay}"
                                 Message="{x:Bind ViewModel.ImportWarningMessage, Mode=OneWay}"
                                 AutomationProperties.AutomationId="ImportWarning" />
                        <InfoBar Severity="Error" IsClosable="False"
                                 IsOpen="{x:Bind local:UiHelpers.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                                 Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                 AutomationProperties.AutomationId="LibraryError">
                            <InfoBar.ActionButton>
                                <Button Content="Try again" Command="{x:Bind ViewModel.LoadCommand}"
                                        AutomationProperties.AutomationId="RetryLibrary" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <ProgressBar IsIndeterminate="True" Foreground="{ThemeResource ReaderAccentBrush}" AutomationProperties.Name="Loading library"
                                     Visibility="{x:Bind local:UiHelpers.When(ViewModel.IsLoading), Mode=OneWay}" />
                        <TextBlock Text="Your library is empty. Import a story to get started." TextWrapping="Wrap"
                                   FontFamily="Georgia" FontSize="17" FontStyle="Italic" Margin="0,12"
                                   Foreground="{ThemeResource ReaderMutedBrush}" TextAlignment="Center"
                                   Visibility="{x:Bind local:UiHelpers.When(ViewModel.IsEmpty), Mode=OneWay}"
                                   AutomationProperties.AutomationId="EmptyLibrary" />
                        <TextBlock Text="No stories match your search or CEFR filter." TextWrapping="Wrap"
                                   FontFamily="Georgia" FontSize="17" FontStyle="Italic" Margin="0,12"
                                   Foreground="{ThemeResource ReaderMutedBrush}" TextAlignment="Center"
                                   Visibility="{x:Bind local:UiHelpers.When(ViewModel.HasNoResults), Mode=OneWay}"
                                   AutomationProperties.AutomationId="NoLibraryResults" />
                    </StackPanel>

                    <Border Grid.Row="3" Margin="0,8,0,0" BorderBrush="{ThemeResource ReaderRuleBrush}" BorderThickness="0,1,0,0">
                        <ListView ItemsSource="{x:Bind ViewModel.Stories, Mode=OneWay}"
                                  IsEnabled="{x:Bind ViewModel.CanUseLibrary, Mode=OneWay}"
                                  Padding="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.AutomationId="StoryLibrary" AutomationProperties.Name="Stories"
                                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnStoryClicked">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="Margin" Value="4,0,4,0" />
                                    <Setter Property="FocusVisualMargin" Value="0" />
                                    <Setter Property="Foreground" Value="{ThemeResource ReaderInkBrush}" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Target="CardSurface.Background" Value="{ThemeResource ReaderLibraryHoverBrush}" />
                                                                    <Setter Target="CardSurface.BorderBrush" Value="{ThemeResource ReaderAccentBrush}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Setters>
                                                                    <Setter Target="CardSurface.Background" Value="{ThemeResource ReaderLibraryHoverBrush}" />
                                                                    <Setter Target="CardSurface.BorderBrush" Value="{ThemeResource ReaderAccentBrush}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                        <VisualStateGroup x:Name="DisabledStates">
                                                            <VisualState x:Name="Enabled" />
                                                            <VisualState x:Name="Disabled">
                                                                <VisualState.Setters>
                                                                    <Setter Target="CardSurface.Opacity" Value="{ThemeResource ListViewItemDisabledThemeOpacity}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <Border x:Name="CardSurface"
                                                            Background="{ThemeResource ReaderPaperBrush}"
                                                            CornerRadius="4"
                                                            Control.IsTemplateFocusTarget="True"
                                                            FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                                            FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                                                            FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                                            FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}"
                                                            FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}">
                                                        <ContentPresenter
                                                            x:Name="StoryPresenter" Foreground="{TemplateBinding Foreground}"
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            ContentTransitions="{TemplateBinding ContentTransitions}"
                                                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                            Margin="{TemplateBinding Padding}" />
                                                    </Border>
                                                    <!-- Keep the rule outside the card so its hover surface has an equal gap on both sides. -->
                                                    <Border Grid.Row="1" Height="1" Margin="0,4,0,4"
                                                            Background="{ThemeResource ReaderRuleBrush}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Story">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock FontFamily="Georgia" FontSize="20" Language="es"
                                                   Text="{x:Bind Title, Mode=OneTime}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                        <TextBlock Grid.Row="1" Text="{x:Bind EnglishTitle, Mode=OneTime}" Language="en"
                                                   Foreground="{ThemeResource ReaderMutedBrush}"
                                                   FontFamily="Georgia" FontStyle="Italic" FontSize="15" Margin="0,3,12,0" TextWrapping="Wrap"
                                                   Visibility="{x:Bind local:UiHelpers.WhenHasText(EnglishTitle), Mode=OneTime}" />

                                        <TextBlock Grid.Column="0" Grid.Row="2" Margin="0,4,12,0" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource ReaderMutedBrush}"
                                                   Visibility="{x:Bind local:UiHelpers.WhenHasText(Author), Mode=OneTime}">
                                            <Run Text="By " /><Run Text="{x:Bind Author, Mode=OneTime}" />
                                        </TextBlock>

                                        <Border
                                            Grid.Column="1"
                                            Grid.Row="0"
                                            Grid.RowSpan="3"
                                            VerticalAlignment="Top"
                                            BorderBrush="{ThemeResource ReaderRuleBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="8,3">

                                            <TextBlock Text="{x:Bind Level, Mode=OneTime}" FontSize="11" CharacterSpacing="100" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- A native Button consumes activation so its menu does
                                             not trigger the containing story's ItemClick. -->
                                        <Button Grid.Column="2" Grid.RowSpan="3" VerticalAlignment="Top" Margin="8,0,0,0"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Foreground="{ThemeResource ReaderInkBrush}"
                                                AutomationProperties.AutomationId="StoryActions"
                                                AutomationProperties.Name="{x:Bind local:MainPage.StoryActionsName(Title), Mode=OneTime}"
                                                ToolTipService.ToolTip="Story actions">
                                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Edit" Tag="{x:Bind}" Click="OnEditStoryClicked"
                                                                    AutomationProperties.AutomationId="EditStory">
                                                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Edit" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Delete" Tag="{x:Bind}" Click="OnDeleteStoryClicked"
                                                                    AutomationProperties.AutomationId="DeleteStory">
                                                        <MenuFlyoutItem.Icon><SymbolIcon Symbol="Delete" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
