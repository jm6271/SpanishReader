<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SpanishReader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SpanishReader"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SpanishReader"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Themes/ReaderTheme.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <!-- Resolve the canvas brush after loading the shared theme resources. -->
        <Grid.Background>
            <ThemeResource ResourceKey="ReaderCanvasBrush" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarLayout" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Only this region drags the window. The adjacent theme button
                 remains a regular, keyboard-accessible XAML button. -->
            <Grid x:Name="AppTitleBar" Background="{ThemeResource ReaderCanvasBrush}">
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="16" Height="16" />
                    <TextBlock Text="SpanishReader" FontSize="12"
                               Foreground="{ThemeResource ReaderInkBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <Button x:Name="ThemeToggleButton" Grid.Column="1"
                        AutomationProperties.AutomationId="ThemeToggleButton"
                        AutomationProperties.Name="Switch to light mode"
                        ToolTipService.ToolTip="Switch to light mode"
                        Style="{StaticResource SubtleButtonStyle}"
                        Width="46" VerticalAlignment="Stretch"
                        Padding="0" BorderThickness="0" CornerRadius="0"
                        Loaded="ThemeToggleButton_Loaded"
                        Click="ThemeToggleButton_Click">
                <Button.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary Source="ms-appx:///Themes/CaptionButtonTheme.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </Button.Resources>
                <Button.Foreground>
                    <ThemeResource ResourceKey="CaptionButtonForeground" />
                </Button.Foreground>
                <FontIcon x:Name="ThemeToggleIcon" Glyph="&#xE706;" FontSize="16" />
            </Button>
            <!-- Reserve exactly the native caption-button area, in XAML units. -->
            <Border x:Name="CaptionButtonInset" Grid.Column="2" Width="138" />
        </Grid>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
