<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SpanishReader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SpanishReader"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SpanishReader"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="ms-appx:///Themes/ReaderTheme.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <!-- Resolve the canvas brush after loading the shared theme resources. -->
        <Grid.Background>
            <ThemeResource ResourceKey="ReaderCanvasBrush" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="SpanishReader"
                  Background="{ThemeResource ReaderCanvasBrush}"
                  Foreground="{ThemeResource ReaderInkBrush}">
            <TitleBar.IconSource>
                <!-- Use a PNG so the image decoder cannot select a small ICO frame and upscale it. -->
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
